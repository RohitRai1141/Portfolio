Ex No :08            convert three-address code to 8086 assembly language 
print("Enter your three-address code (one line at a time).\nWhen you're done, enter an empty line:")
tac_lines = []
while (line := input().strip()) != "":
    tac_lines.append(line)

assembly_code = []
register_map = {}
current_register = 1

def get_next_register():
    global current_register
    reg = f"R{current_register}"
    current_register += 1
    return reg

for line in tac_lines:
    target, expression = map(str.strip, line.split("="))
    
    if "+" in expression:
        op1, op2 = map(str.strip, expression.split("+"))
        reg1 = register_map.get(op1, get_next_register())
        if op1 not in register_map:
            assembly_code.append(f"LD {reg1} {op1}")
            register_map[op1] = reg1
        
        reg2 = register_map.get(op2, get_next_register())
        if op2 not in register_map:
            assembly_code.append(f"LD {reg2} {op2}")
            register_map[op2] = reg2
        
        reg_result = get_next_register()
        assembly_code.append(f"ADD {reg_result} {reg1} {reg2}")
        assembly_code.append(f"ST {target} {reg_result}")
        register_map[target] = reg_result
    else:
        reg = get_next_register()
        assembly_code.append(f"LD {reg} {expression}")
        assembly_code.append(f"ST {target} {reg}")
        register_map[target] = reg

print("\nGenerated Assembly Code:")
print("\n".join(assembly_code))




