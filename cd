n = int(input("Enter number of lines: "))
table = []

for _ in range(n):
    str_line = input().strip().split(" ")

    for k in str_line:
        snip = []
        if k in ["int", "char", "float", "double"]:
            v = str_line.index(k)
            u = str_line[v + 1]
            variables = u.split(";")[0].split(",")

            for var in variables:
                if '=' in var:
                    var_name = var.split("=")[0]
                    if not any(var_name in item for item in table):
                        snip.extend([var_name, id(var_name), k])
                else:
                    if not any(var in item for item in table):
                        snip.extend([var, id(var), k])

        if snip:
            table.append(snip)

# Output the symbol table
print("\nSymbol  Address  Type")
for row in table:
    for i, item in enumerate(row):
        if i % 3 == 0 and i != 0:
            print()  # New line after every 3 items
        print(item, end="   ")

