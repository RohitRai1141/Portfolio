Ex No :  5                        THREE ADDRESS CODE GENERATOR          

print("Enter an arithmetic expression (with or without assignment):")
expression = input().strip()

tac = []  # Stores the three-address code
temp_counter = 1  # Counter for temporary variables

# Function to generate unique temporary variable names
def get_temp():
    global temp_counter
    temp_var = f"t{temp_counter}"
    temp_counter += 1
    return temp_var

# Recursive function to parse the expression and generate TAC
def parse_expression(expr):
    # Handle parentheses by recursively solving the inner expression
    while "(" in expr:
        open_paren = expr.rfind("(")
        close_paren = expr.find(")", open_paren)
        inner_expr = expr[open_paren + 1:close_paren]
        temp_var = parse_expression(inner_expr)
        expr = expr[:open_paren] + temp_var + expr[close_paren + 1:]

    # Handle operators in precedence order
    for op in ["+", "-", "*", "/"]:
        if op in expr:
            left, right = map(str.strip, expr.split(op, 1))
            temp_left = parse_expression(left) if any(c in left for c in "+-*/") else left
            temp_right = parse_expression(right) if any(c in right for c in "+-*/") else right
            temp_var = get_temp()
            tac.append(f"{temp_var} = {temp_left} {op} {temp_right}")
            return temp_var

    return expr.strip()

# Check if the expression has an assignment
if "=" in expression:
    target, expr = map(str.strip, expression.split("=", 1))
    result_var = parse_expression(expr)
    tac.append(f"{target} = {result_var}")
else:
    parse_expression(expression)

# Print the generated Three-Address Code
print("\nThree-Address Code:")
for line in tac:
    print(line)












Ex No :06                                    TYPE CHECKING

print("Enter your three-address code (one line at a time).")
code = []

# Input lines of three-address code
while True:
    line = input().strip()
    if line == "":
        break
    code.append(line)

# Function to check data type compatibility
def check_data_type(var, expr, type_dict):
    operators = "+-*/"
    # Check for direct assignments without operators
    if all(op not in expr for op in operators):
        if type_dict[var] == "float" and not expr.replace('.', '', 1).isdigit():
            return False
        if type_dict[var] == "int" and not expr.isdigit():
            return False
        if type_dict[var] == "char" and len(expr) != 1:
            return False
        return True

    # For expressions with operators, ensure types of all variables match
    operands = [item.strip() for item in expr.replace("+", "#").replace("-", "#").replace("*", "#").replace("/", "#").split("#")]
    return all(type_dict.get(operand, type_dict[var]) == type_dict[var] for operand in operands)

# Dictionary to store variable types
type_dict = {}

for line in code:
    line = line.split(";")[0].strip()  # Remove trailing semicolons
    if any(dtype in line for dtype in ["int", "float", "char", "double"]):
        dtype, rest = line.split(maxsplit=1)
        if "=" in rest:
            var, expr = map(str.strip, rest.split("=", 1))
            type_dict[var] = dtype
            if not check_data_type(var, expr, type_dict):
                print("Error: Mismatched data types")
                exit(1)
        else:
            var = rest.strip()
            type_dict[var] = dtype
    elif "=" in line:
        var, expr = map(str.strip, line.split("=", 1))
        if not check_data_type(var, expr, type_dict):
            print("Error: Mismatched data types")
            exit(1)

