              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Text('Income'),
                Switch(
                  value: isIncome,
                  onChanged: (val) {
                    setState(() {
                      isIncome = val;
                    });
                  },
                ),
                Text('Expense'),
              ],
            ),
            ElevatedButton(
              onPressed: addEntry,
              child: Text('Add Entry'),
            ),

            // Chart
            Padding(
              padding: const EdgeInsets.all(16.0),
              child: AspectRatio(
                aspectRatio: 1.0,
                child: PieChart(
                  PieChartData(
                    sections: showingSections(),
                  ),
                ),
              ),
            ),

            // Display Entries
            ListView.builder(
              shrinkWrap: true,
              itemCount: entries.length,
              itemBuilder: (context, index) {
                return ListTile(
                  title: Text(entries[index].category),
                  subtitle: Text('${entries[index].amount} - ${entries[index].isIncome ? 'Income' : 'Expense'}'),
                );
              },
            ),
          ],
        ),
      ),
    );
  }

  List<PieChartSectionData> showingSections() {
    double totalIncome = 0;
    double totalExpense = 0;

    Map<String, double> categoryTotal = {};

    for (var entry in entries) {
      if (entry.isIncome) {
        totalIncome += entry.amount;
      } else {
        totalExpense += entry.amount;
      }
      if (categoryTotal.containsKey(entry.category)) {
        categoryTotal[entry.category] = categoryTotal[entry.category]! + entry.amount;
      } else {
        categoryTotal[entry.category] = entry.amount;
      }
    }

    return categoryTotal.entries.map((e) {
      return PieChartSectionData(
        color: Colors.blue,
        value: e.value,
        title: '${e.key}: ${e.value.toStringAsFixed(2)}',
      );
    }).toList();
  }
}

