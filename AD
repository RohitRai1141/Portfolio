document.addEventListener('deviceready', function () {
    const db = window.sqlitePlugin.openDatabase({ name: 'my.db', location: 'default' });

    // Create table
    db.transaction(function (txn) {
        txn.executeSql('CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT)', [], function () {
            console.log("Table created successfully");
        }, function (error) {
            console.log("Error creating table: " + error.message);
        });
    });

    // Insert data
    document.getElementById('saveButton').addEventListener('click', function () {
        const name = document.getElementById('nameInput').value;
        db.transaction(function (txn) {
            txn.executeSql('INSERT INTO users (name) VALUES (?)', [name], function () {
                console.log("Data inserted successfully");
            }, function (error) {
                console.log("Error inserting data: " + error.message);
            });
        });
    });

    // Fetch data
    document.getElementById('fetchButton').addEventListener('click', function () {
        db.transaction(function (txn) {
            txn.executeSql('SELECT * FROM users', [], function (tx, results) {
                for (let i = 0; i < results.rows.length; i++) {
                    console.log("User: " + results.rows.item(i).name);
                }
            }, function (error) {
                console.log("Error fetching data: " + error.message);
            });
        });
    });
});

