package com.example.library_management;

import android.os.Bundle;
import android.view.View;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    private EditText bookNameEditText, authorEditText, viewBookEditText, updateBookNameEditText, updateAuthorEditText, deleteBookEditText;
    private TextView resultTextView;
    private DB dbHelper;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        bookNameEditText = findViewById(R.id.editTextTextPersonName);
        authorEditText = findViewById(R.id.editTextTextPersonName2);
        viewBookEditText = findViewById(R.id.editTextTextPersonName3);
        updateBookNameEditText = findViewById(R.id.editTextTextPersonName4);
        updateAuthorEditText = findViewById(R.id.editTextTextPersonName5);
        deleteBookEditText = findViewById(R.id.editTextTextPersonName6);
        resultTextView = findViewById(R.id.textView);
        dbHelper = new DB(this);
    }

    public void save(View view) {
        String bookName = bookNameEditText.getText().toString().trim();
        String author = authorEditText.getText().toString().trim();
        if (!bookName.isEmpty() && !author.isEmpty()) {
            dbHelper.save(bookName, author);
            Toast.makeText(this, "Book saved successfully!", Toast.LENGTH_SHORT).show();
        } else {
            Toast.makeText(this, "Please enter book name and author.", Toast.LENGTH_SHORT).show();
        }
    }

    public void retrieve(View view) {
        String bookName = viewBookEditText.getText().toString().trim();
        if (!bookName.isEmpty()) {
            String author = dbHelper.retrieve(bookName);
            resultTextView.setText(author);
        } else {
            Toast.makeText(this, "Please enter book name to view.", Toast.LENGTH_SHORT).show();
        }
    }

    public void update(View view) {
        String bookName = updateBookNameEditText.getText().toString().trim();
        String newAuthor = updateAuthorEditText.getText().toString().trim();
        if (!bookName.isEmpty() && !newAuthor.isEmpty()) {
            dbHelper.update(bookName, newAuthor);
            Toast.makeText(this, "Book updated successfully!", Toast.LENGTH_SHORT).show();
        } else {
            Toast.makeText(this, "Please enter book name and new author to update.", Toast.LENGTH_SHORT).show();
        }
    }

    public void delete(View view) {
        String bookName = deleteBookEditText.getText().toString().trim();
        if (!bookName.isEmpty()) {
            dbHelper.delete(bookName);
            Toast.makeText(this, "Book deleted successfully!", Toast.LENGTH_SHORT).show();
        } else {
            Toast.makeText(this, "Please enter book name to delete.", Toast.LENGTH_SHORT).show();
        }
    }

    public void borrow(View view) {
