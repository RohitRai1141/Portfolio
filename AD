package com.example.calculator;

import androidx.appcompat.app.AppCompatActivity;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;

public class MainActivity extends AppCompatActivity {

    private TextView textViewResult;
    private String currentInput = "";
    private String operator = "";
    private double firstOperand = 0;
    private boolean hasDecimal = false;  // Variable to track decimal point usage

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        textViewResult = findViewById(R.id.textViewResult);

        // Set onClickListener for each button
        setButtonListeners();
    }

    private void setButtonListeners() {
        int[] buttonIds = {R.id.btn0, R.id.btn1, R.id.btn2, R.id.btn3, R.id.btn4,
                R.id.btn5, R.id.btn6, R.id.btn7, R.id.btn8, R.id.btn9,
                R.id.btnAdd, R.id.btnSubtract, R.id.btnMultiply, R.id.btnDivide,
                R.id.btnEqual, R.id.btnClr, R.id.btnBackspace, R.id.btnDecimal};

        for (int id : buttonIds) {
            findViewById(id).setOnClickListener(new View.OnClickListener() {
                @Override
                public void onClick(View v) {
                    onButtonClick((Button) v);
                }
            });
        }
    }

    private void onButtonClick(Button button) {
        String buttonText = button.getText().toString();

        switch (buttonText) {
            case "CLR":
                clearInput();
                break;
            case "⌫":
                backspaceInput();
                break;
            case ".":
                appendDecimal();
                break;
            case "+":
            case "-":
            case "*":
            case "/":
                setOperator(buttonText);
                break;
            case "=":
                calculateResult();
                break;
            default: // Numbers
                appendInput(buttonText);
                break;
        }
    }
    private void appendInput(String value) {
        currentInput += value;
        textViewResult.setText(currentInput);
    }

    private void clearInput() {
        currentInput = "";
        operator = "";
        firstOperand = 0;
        hasDecimal = false;  // Reset decimal flag
        textViewResult.setText("0");
    }

    private void backspaceInput() {
        if (!currentInput.isEmpty()) {
            if (currentInput.endsWith(".")) {
                hasDecimal = false;  // If backspacing decimal, reset flag
            }
            currentInput = currentInput.substring(0, currentInput.length() - 1);
            textViewResult.setText(currentInput.isEmpty() ? "0" : currentInput);
        }
    }

    private void appendDecimal() {
        if (!hasDecimal) {
            if (currentInput.isEmpty()) {
                currentInput = "0";  // Prepend "0" if starting with decimal
            }
            currentInput += ".";
            textViewResult.setText(currentInput);
            hasDecimal = true;  // Set flag to prevent multiple decimals
        }
    }

    private void setOperator(String op) {
        if (!currentInput.isEmpty()) {
            firstOperand = Double.parseDouble(currentInput);
            currentInput = "";
            operator = op;
            hasDecimal = false;  // Reset decimal flag when operator is pressed
            textViewResult.setText(operator);
        }
    }

    private void calculateResult() {
        if (!currentInput.isEmpty() && !operator.isEmpty()) {
            double secondOperand = Double.parseDouble(currentInput);
            double result = 0;

            switch (operator) {
                case "+":
                    result = firstOperand + secondOperand;
                    break;
                case "-":
                    result = firstOperand - secondOperand;
                    break;
                case "*":
                    result = firstOperand * secondOperand;
                    break;
                case "/":
                    result = firstOperand / secondOperand;
                    break;
            }
            textViewResult.setText(String.valueOf(result));
            currentInput = String.valueOf(result);
            operator = "";
            hasDecimal = currentInput.contains(".");  // Check if result contains decimal
        }
    }
}














